{
  "name": "program-capacity-service",
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@casl/ability": "6.8.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "jose": "6.2.13",
    "kafkajs": "2.2.4",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "11.2.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./dist/core/*",
    "#config/*": "./dist/config/*",
    "#constants/*": "./dist/constants/*",
    "#decorators/*": "./dist/decorators/*",
    "#guards/*": "./dist/guards/*",
    "#interceptors/*": "./dist/interceptors/*",
    "#filters/*": "./dist/filters/*",
    "#helpers/*": "./dist/helpers/*",
    "#interfaces/*": "./dist/interfaces/*",
    "#generated/*": "./dist/generated/*"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node scripts/test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "check:architecture": "node scripts/check-architecture.mjs --project .",
    "test:core": "npm run build && node scripts/test.mjs --core",
    "test:coverage": "npm run test:unit -- --coverage --coverageDirectory=coverage/unit",
    "test:migrations": "npm run build && node scripts/test-migrations.mjs",
    "test:smoke": "npm run build && node scripts/test-smoke.mjs",
    "test:unit": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=unit",
    "test:integration": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "dev:prepare": "node scripts/dev.mjs prepare",
    "dev:token": "node scripts/dev.mjs token",
    "dev:credentials": "node scripts/dev.mjs credentials",
    "web:build": "npm --prefix web run build",
    "web:test": "npm run build && node scripts/test-web.mjs",
    "db:seed": "node scripts/seed.mjs",
    "demo": "node scripts/demo.mjs",
    "openapi": "node scripts/openapi.mjs"
  }
}
