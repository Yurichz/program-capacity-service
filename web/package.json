{
  "name": "program-capacity-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node server.mjs",
    "lint": "eslint src server.mjs test vite.config.ts playwright.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "@fontsource/inter": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@playwright/test": "1.64.1"
  }
}
